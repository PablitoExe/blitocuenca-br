{
  "name": "blitocuenca-br",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "db:types": "if [ -z \"$SUPABASE_PROJECT_ID\" ]; then echo \"Falta SUPABASE_PROJECT_ID (ver .env.example)\"; exit 1; fi; supabase gen types typescript --project-id \"$SUPABASE_PROJECT_ID\" --schema public > .database.types.tmp && mv .database.types.tmp src/types/database.ts && prettier --write src/types/database.ts",
    "db:types:local": "supabase gen types typescript --local --schema public > .database.types.tmp && mv .database.types.tmp src/types/database.ts && prettier --write src/types/database.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@react-router/node": "^7.18.4",
    "@react-router/serve": "^7.18.4",
    "@tanstack/react-query": "^5.104.0",
    "isbot": "^5.2.2",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.89.0",
    "react-router": "^7.18.4",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@react-router/dev": "^7.18.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vercel/react-router": "^1.3.6",
    "jsdom": "^30.1.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.118.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
